{
  "name": "assistant-dashboards",
  "version": "3.7.0.0",
  "main": "index.ts",
  "license": "Apache-2.0",
  "scripts": {
    "osd": "node ../../scripts/osd",
    "build": "yarn plugin-helpers build",
    "test:jest": "../../node_modules/.bin/jest --config ./test/jest.config.js",
    "plugin-helpers": "node ../../scripts/plugin_helpers",
    "prepare": "husky install",
    "lint:es": "node ../../scripts/eslint",
    "lint": "yarn lint:es"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn lint --fix"
    ]
  },
  "dependencies": {
    "autosize": "^6.0.1",
    "csv-parser": "^3.0.0",
    "dompurify": "^3.4.7",
    "eventsource-parser": "^3.0.1",
    "jsdom": "^21.1.2",
    "postinstall": "^0.11.2"
  },
  "devDependencies": {
    "@types/autosize": "^4.0.3",
    "@types/jsdom": "^21.1.2",
    "husky": "^8.0.3",
    "jest-dom": "^4.0.0",
    "lint-staged": "^15.2.10"
  },
  "eslintIgnore": [
    "node_modules/*",
    "target/*"
  ],
  "resolutions": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "cross-spawn": "^7.0.5",
    "lodash": "^4.18.0"
  }
}